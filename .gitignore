# Android .gitignore
# Author: Vipul Jha
# Updated: Dec 20, 2025
# Purpose: Clean, editor-agnostic ignore rules for Android projects


# --------------------------
# Android / Gradle
# --------------------------
*.iml
.gradle/
local.properties
.cxx/
.externalNativeBuild/
.navigation/

# --------------------------
# Android Studio / IntelliJ
# --------------------------
.idea/

# --------------------------
# Build outputs
# --------------------------
**/build/
*.apk
*.ap_
*.aab
output.json
release/

# --------------------------
# Kotlin
# --------------------------
.kotlin/
*.main.kts

# --------------------------
# System files
# --------------------------
.DS_Store
Thumbs.db
*.log
*.hprof

# --------------------------
# Secrets & Signing
# --------------------------
keystore.properties
#*.jks
#*.keystore
#google-services.json
#secrets.properties
# --------------------------
# Verification screenshots
# --------------------------
/screenshots/
/platforms/android/screenshots/

# Perfetto traces from platforms/android/tools/perf
/platforms/android/perf-out/
__pycache__/
